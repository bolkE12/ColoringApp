{
  "expo": {
    "name": "Coloring Creatures",
    "slug": "coloring-creatures",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "coloringcreatures",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#4CA0E8"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "requiresFullScreen": false,
      "bundleIdentifier": "com.creature.coloring",
      "buildNumber": "1",
      "infoPlist": {
        "UIDeviceFamily": [
          2
        ],
        "NSPhotoLibraryUsageDescription": "This app needs access to your photo library to save your colored animal creations.",
        "NSPhotoLibraryAddUsageDescription": "This app needs permission to save your colored animals to your photo library.",
        "NSMicrophoneUsageDescription": "This app uses audio for background music and sound effects to enhance the coloring experience.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4CA0E8"
      },
      "package": "com.creature.coloring",
      "versionCode": 1,
      "permissions": [
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_EXTERNAL_STORAGE"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "YOUR_PROJECT_ID_HERE"
      }
    }
  }
}
