{
  "expo": {
    "name": "Coloring Creatures",
    "slug": "coloring-creatures",
    "version": "1.0.0",
    "cli": {
      "appVersionSource": "local"
    },
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "coloringcreatures",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "cover",
      "backgroundColor": "#4CA0E8"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "isTabletOnly": true,
      "requiresFullScreen": false,
      "bundleIdentifier": "com.creature.coloring",
      "buildNumber": "11",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "This app needs access to your photo library to save your colored animal creations.",
        "NSPhotoLibraryAddUsageDescription": "This app needs permission to save your colored animals to your photo library.",
        "NSMicrophoneUsageDescription": "This app uses audio for background music and sound effects to enhance the coloring experience.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4CA0E8"
      },
      "package": "com.creature.coloring",
      "versionCode": 1,
      "permissions": [
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.1",
            "extraXcodeSettings": {
              "TARGETED_DEVICE_FAMILY": "2"
            }
          },
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 24,
            "buildToolsVersion": "35.0.0"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "9576650e-3c41-422f-b7ca-585e587ddcb7"
      }
    },
    "owner": "bolke"
  }
}
